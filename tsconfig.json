{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "outDir": "build",
        "rootDir": "./src",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "build"]
}